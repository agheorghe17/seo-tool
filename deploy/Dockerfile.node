# Shared Dockerfile for `api` and `worker`. Pick the app with --build-arg APP=api|worker.
FROM node:22-slim AS base
ENV PNPM_HOME=/pnpm
ENV PATH="$PNPM_HOME:$PATH"
RUN corepack enable
WORKDIR /app

FROM base AS deps
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json ./
COPY packages ./packages
COPY apps ./apps
RUN pnpm install --frozen-lockfile

FROM deps AS runtime
ARG APP
ENV APP=${APP}
# tsx runs the TypeScript entrypoint directly; no build step for server apps.
CMD ["sh", "-c", "pnpm --filter ${APP} start"]

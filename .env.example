# ─── Core ────────────────────────────────────────────────────────────────────
NODE_ENV=development

# Postgres (Supabase connection string — use the pooler URL for apps, direct URL for migrations)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/seo_tool
# Direct (non-pooled) connection, used only by drizzle-kit migrations
DATABASE_URL_DIRECT=postgresql://postgres:postgres@localhost:5432/seo_tool

# Redis (Upstash) — CACHE ONLY, not the job queue
REDIS_URL=redis://localhost:6379

# 32-byte key, base64 or hex encoded — used for AES-256-GCM encryption of site secrets
# generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=

# ─── Supabase (Auth) ─────────────────────────────────────────────────────────
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Optional: only if you verify legacy HS256 Supabase JWTs instead of the JWKS endpoint
SUPABASE_JWT_SECRET=

# ─── Web (apps/web, browser-exposed) ─────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001

# ─── LLM (pluggable) ─────────────────────────────────────────────────────────
# anthropic | ollama | none
LLM_PROVIDER=none
ANTHROPIC_API_KEY=
# Cheap model is plenty for short rule explanations; override if you want higher quality.
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
ANTHROPIC_MAX_TOKENS=600
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
# LLM explanation cache TTL (seconds); identical (rule, version, value) reuse the same text.
LLM_CACHE_TTL_SECONDS=2592000

# ─── Google (free data sources) ─────────────────────────────────────────────
# PageSpeed Insights API key (also used for CrUX API)
PAGESPEED_API_KEY=
# OAuth for Google Search Console (per-site connect)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3001/api/sites/gsc/callback
# GA4 reuses the same OAuth client + a second redirect URI (scope: analytics.readonly).
# Defaults to GOOGLE_OAUTH_REDIRECT_URI with /gsc/callback → /ga/callback if unset.
GOOGLE_OAUTH_GA_REDIRECT_URI=http://localhost:3001/api/sites/ga/callback
# Google Business Profile (Epic 21) — OFF: the GBP APIs need an access request approved by Google.
FEATURE_GBP=off
# GOOGLE_OAUTH_GBP_REDIRECT_URI=http://localhost:3001/api/sites/gbp/callback

# ─── DataForSEO (feature-flagged, OFF by default) ───────────────────────────
FEATURE_DATAFORSEO=off
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

# ─── Feature flags / limits ─────────────────────────────────────────────────
FEATURE_BILLING=off
RENDER_ENABLED=0          # 1 = run Playwright render worker (needs Chromium installed)
SCORING_WEIGHTS=          # optional JSON, e.g. {"geo":0.15,"content":0.15}
ESTIMATE_HORIZON_MONTHS=6
RETAIN_CRAWLS_PER_SITE=5  # older crawls per site are pruned (stay within free DB tier)

# ─── Transactional email (optional, Resend free tier) ──────────────────────
RESEND_API_KEY=
EMAIL_FROM=SEO Audit <onboarding@resend.dev>

# ─── Strategy module — keywords & competitors (Epics 13-19) ─────────────────
STRATEGY_GEO=ro
STRATEGY_LANG=ro
KEYWORD_UNIVERSE_MAX=1000
COMPETITOR_CRAWL_MAX_PAGES=300
RANK_REFRESH_CRON=0 6 * * 1            # weekly, Monday 06:00

# Google Ads Keyword Planner — FREE volume/ideas. Without a developer token the
# keyword universe still works (autocomplete + GSC), just no search volume.
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=          # MCC id, digits only

# Pluggable SERP provider — OFF by default. Adds live competitor positions when set.
# none | dataforseo | serpapi | scaleserp | valueserp
SERP_PROVIDER=none
SERP_API_KEY=
SERP_MAX_KEYWORDS=200

# ─── Ports ──────────────────────────────────────────────────────────────────
API_PORT=3001
WEB_PORT=3000
API_BASE_URL=http://localhost:3001
WEB_BASE_URL=http://localhost:3000

# ─── Crawler defaults ───────────────────────────────────────────────────────
CRAWL_MAX_PAGES=2000
CRAWL_REQUESTS_PER_SECOND=2
CRAWL_USER_AGENT=SeoToolBot/0.1 (+https://example.com/bot)

# ─── Observability ──────────────────────────────────────────────────────────
SENTRY_DSN=

# ─── Core ────────────────────────────────────────────────────────────────────
NODE_ENV=development

# Postgres (Supabase connection string — use the pooler URL for apps, direct URL for migrations)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/seo_tool
# Direct (non-pooled) connection, used only by drizzle-kit migrations
DATABASE_URL_DIRECT=postgresql://postgres:postgres@localhost:5432/seo_tool

# Redis (Upstash) — CACHE ONLY, not the job queue
REDIS_URL=redis://localhost:6379

# 32-byte key, base64 or hex encoded — used for AES-256-GCM encryption of site secrets
# generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=

# ─── Supabase (Auth) ─────────────────────────────────────────────────────────
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ─── LLM (pluggable) ─────────────────────────────────────────────────────────
# anthropic | ollama | none
LLM_PROVIDER=none
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# ─── Google (free data sources) ─────────────────────────────────────────────
# PageSpeed Insights API key (also used for CrUX API)
PAGESPEED_API_KEY=
# OAuth for Google Search Console (per-site connect)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3001/api/sites/gsc/callback

# ─── DataForSEO (feature-flagged, OFF by default) ───────────────────────────
FEATURE_DATAFORSEO=off
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

# ─── Ports ──────────────────────────────────────────────────────────────────
API_PORT=3001
WEB_PORT=3000
API_BASE_URL=http://localhost:3001
WEB_BASE_URL=http://localhost:3000

# ─── Crawler defaults ───────────────────────────────────────────────────────
CRAWL_MAX_PAGES=2000
CRAWL_REQUESTS_PER_SECOND=2
CRAWL_USER_AGENT=SeoToolBot/0.1 (+https://example.com/bot)

# ─── Observability ──────────────────────────────────────────────────────────
SENTRY_DSN=
